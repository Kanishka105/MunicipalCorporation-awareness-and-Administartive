# CivicPulse AI Backend Environment Configuration Example

APP_NAME=CivicPulse AI
ENVIRONMENT=development
# Set to True for testing purposes (allows login with dummy tokens)
DEMO_AUTH_ENABLED=True
SECRET_KEY=your-super-secret-key-change-in-production

# AWS Settings
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Cognito (For Login & User Management)
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_example_pool
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_IDENTITY_POOL_ID=ap-south-1:example-identity-pool-id
DASHBOARD_COGNITO_CLIENT_ID=your-dashboard-client-id-without-secret

# Amazon Location Service (For Maps)
LOCATION_SERVICE_MAP_NAME=civicpulse-dashboard-map

# AWS S3 (For saving data/uploads)
S3_BUCKET=civicpulse-uploads

# DynamoDB Tables (If using AWS DynamoDB instead of local mock DB)
DYNAMODB_REPORTS_TABLE=civicpulse-reports
DYNAMODB_TASKS_TABLE=civicpulse-tasks
DYNAMODB_USERS_TABLE=civicpulse-users

# Upload Limits
MAX_UPLOAD_SIZE_MB=10

# AI/ML Thresholds
AI_CONFIDENCE_THRESHOLD=0.75
DUPLICATE_SIMILARITY_THRESHOLD=0.9
DEFAULT_SLA_HOURS=72

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUIRE_HTTPS=True
